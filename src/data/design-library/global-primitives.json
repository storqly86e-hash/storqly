            "announcement",
            "carousel",
            "service"
          ],
          "visual_style": [
            "quiet utility",
            "single-line information"
          ],
          "industries": [
            "all ecommerce"
          ],
          "brand_personalities": [
            "clear",
            "service-minded",
            "campaign-driven"
          ],
          "incompatible_with": [
            "announcement.utility_single"
