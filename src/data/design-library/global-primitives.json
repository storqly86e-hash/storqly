    "announcement-bar": {
      "records": [
        {
          "id": "announcement.utility_single",
          "family": "announcement-bar",
          "variant": "utility_single",
          "intent": "Communicate one useful store-wide message without competing with navigation.",
          "use_when": [
            "shipping_threshold",
            "service_message",
            "launch_note"
          ],
          "avoid_when": [
            "multiple_messages",
            "urgent_promotion_needing_detail"
          ],
          "slots": [
            "message",
            "optional_link",
            "dismiss_control"
          ],
          "layout": {
            "desktop": "single centered line at 36–40px height",
            "alignment": "center"
          },
          "responsive": {
            "mobile_behavior": "truncate only with accessible expansion; preserve the actionable link"
          },
          "style_hooks": [
            "surface",
            "content_color",
            "height",
            "label_style",
            "dismissible"
          ],
          "compatible_with": [
            "header.wordmark_center",
            "hero.editorial_masthead",
            "promotion.inline_offer"
          ],
          "content_rules": {
            "max_characters": 90,
            "one_message_only": true
          },
          "motion": "No auto-rotating messages.",
          "tags": [
            "announcement",
            "utility",
            "low_noise"
          ],
          "visual_style": [
            "quiet utility",
            "single-line information"
          ],
          "industries": [
            "all ecommerce"
          ],
          "brand_personalities": [
            "clear",
            "service-minded",
            "practical"
          ],
          "incompatible_with": [
            "announcement.rail_rotating"
          ],
          "conflict_scope": "avoid_adjacent_or_same_primary_role"
        },
        {
          "id": "announcement.rail_rotating",
          "family": "announcement-bar",
          "variant": "rail_rotating",
          "intent": "Rotate a small set of meaningful service or offer messages while keeping user control.",
          "use_when": [
            "multiple_service_promises",
            "seasonal_campaign",
            "high_message_value"
          ],
          "avoid_when": [
            "low_traffic",
            "complex_terms",
            "regulated_claims"
          ],
          "slots": [
            "message_items",
            "previous_control",
            "next_control",
            "pause_control"
          ],
          "layout": {
            "desktop": "single-line carousel with explicit controls",
            "alignment": "center"
          },
          "responsive": {
            "mobile_behavior": "one message at a time with manual controls; never rely on timing alone"
          },
          "style_hooks": [
            "surface",
            "control_visibility",
            "rotation_interval",
            "height"
