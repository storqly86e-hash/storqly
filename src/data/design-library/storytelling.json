        {
          "id": "brand-story.split_art-directed",
          "family": "brand-story",
          "variant": "split_art-directed",
          "intent": "Explain the brand point of view through a strong image and a concise narrative.",
          "use_when": [
            "luxury",
            "founder_led",
            "heritage",
            "editorial",
            "mission_driven"
          ],
          "avoid_when": [
            "no_story_asset",
            "short_promo_page"
          ],
          "slots": [
            "image",
            "eyebrow",
            "headline",
            "body",
            "proof_note",
            "link",
            "caption"
          ],
          "layout": {
            "desktop": "asymmetric 5/7 split with image allowed to bleed and copy on a calm surface",
            "alignment": "text-led vertical rhythm"
          },
          "responsive": {
            "mobile_behavior": "image above copy; caption remains visible; body measure stays narrow"
          },
          "style_hooks": [
            "split_ratio",
            "image_ratio",
            "surface_theme",
            "type_pairing",
            "copy_measure",
            "caption_style"
