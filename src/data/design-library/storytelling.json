          ],
          "content_rules": {
            "headline_max_words": 10,
            "body_max_words": 90,
            "proof_note_max_words": 16
          },
          "image_guidance": {
            "image": "Show the actual maker, material, use context, or product world. Favor tactile detail and a specific point of view over generic lifestyle imagery.",
            "prompt_frame": "art-directed brand story for [brand/category], [maker/material/use context], tactile editorial commercial photography, [palette], natural light, no text"
          },
          "motion": "Image appears with a slow opacity reveal; no parallax by default.",
          "tags": [
            "brand-story",
            "split",
            "editorial",
            "mission"
          ],
          "visual_style": [
            "narrative",
            "editorial",
