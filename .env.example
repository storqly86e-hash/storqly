# ═══════════════════════════════════════════════════════════════════
# Storqly — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this to .env.local for local dev, or set in Railway/Render Dashboard.
# Values marked ⭐ are REQUIRED for production.

# ── Database (Neon Postgres) ──────────────────────────────────
# Pooled connection (for app runtime — goes through Neon's PgBouncer) ⭐ REQUIRED
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Direct connection (for Prisma migrations — bypasses pooler)
# ⭐ Required for `prisma db push` / `prisma migrate deploy`
DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Auth ──────────────────────────────────────────────────────
# ⭐ REQUIRED. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# ⭐ REQUIRED in production. Set to your deployment URL:
NEXTAUTH_URL=https://your-app.up.railway.app

# ── AI Providers (at least ONE required for store generation) ──

# OpenRouter (⭐ PRIMARY production provider)
# Get a key at https://openrouter.ai/keys (format: sk-or-v1-...)
# Default model: deepseek/deepseek-chat-v3-0324
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: override the default model
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# Google AI Studio / Gemini (optional secondary — free tier: 15 RPM)
# Get a key at https://aistudio.google.com/apikey (format: AIzaSy...)
GOOGLE_AI_API_KEY=AIzaSyYour-key-here

# ── Optional (dev-only / sandbox-only) ───────────────────────
# UNSPLASH_ACCESS_KEY — not needed (image search uses z-ai CLI in sandbox,
#   and on production, products keep their AI-generated URLs)
UNSPLASH_ACCESS_KEY=placeholder
