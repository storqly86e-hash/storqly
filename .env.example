# ═══════════════════════════════════════════════════════════════════
# Storqly — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this to .env.local for local dev, or set in Render Dashboard.
# Values marked ⭐ are REQUIRED for production.

# ── Database (Neon Postgres) ──────────────────────────────────
# Pooled connection (for app runtime — goes through Neon's PgBouncer)
DATABASE_URL=postgresql://user:pass@ep-xxx.region.pooler.neon.tech/storqly?sslmode=require&pgbouncer=true

# Direct connection (for Prisma migrations — bypasses pooler)
# ⭐ Required for `prisma db push` / `prisma migrate deploy`
DIRECT_URL=postgresql://user:pass@ep-xxx.region.neon.tech/storqly?sslmode=require

# ── Auth ──────────────────────────────────────────────────────
# ⭐ REQUIRED. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# ⭐ REQUIRED in production. Set to your Render URL:
NEXTAUTH_URL=https://your-app.onrender.com

# ── AI Providers (at least ONE required for store generation) ──
# GROQ (free tier: ~30 RPM) — PRIMARY on production
GROQ_API_KEY=gsk_your-key-here

# Google AI Studio / Gemini (free tier: 15 RPM) — BACKUP on production
GOOGLE_AI_API_KEY=AIzaSyYour-key-here

# ── Optional (dev-only / sandbox-only) ───────────────────────
# UNSPLASH_ACCESS_KEY — not needed (image search uses z-ai CLI in sandbox,
#   and on production, products keep their AI-generated URLs)
UNSPLASH_ACCESS_KEY=placeholder
