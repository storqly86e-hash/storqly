# === Database ===
DATABASE_URL=file:./db/custom.db

# === Auth ===
NEXTAUTH_SECRET=<generate with: openssl rand -base64 32>
NEXTAUTH_URL=http://localhost:3000

# === Image Search (z-ai CLI, optional — has built-in defaults) ===
UNSPLASH_ACCESS_KEY=placeholder

# === AI Providers (multi-provider failover) ===
# Primary: z-ai (built-in, no key needed — uses z-ai-web-dev-sdk auth)
# Backup 1: GROQ — https://console.groq.com → API Keys
GROQ_API_KEY=
# Backup 2: Google AI Studio (Gemini) — https://aistudio.google.com → Get API Key
GOOGLE_AI_API_KEY=
